    gap: 10px;
    font-weight: 700;
    font-size: 16px;
  }

  .mobile-brand i {
    color: #38bdf8;
  }

  .menu-toggle {
    background: transparent;
    border: none;
    color: #fff;
    font-size: 22px;
    cursor: pointer;
  }

  .app-layout {
    padding-top: 80px;
    flex-direction: column;
  }

  /* Transforma a sidebar em uma gaveta deslizante no Mobile */
  .sidebar-blur {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: 280px;
    border-radius: 0 20px 20px 0;
    transform: translateX(-100%);
    z-index: 300;
  }

  .sidebar-blur.open {
    transform: translateX(0);
  }

  .menu-backdrop {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    z-index: 250;
  }

  .menu-backdrop.active {
    opacity: 1;
    pointer-events: auto;
  }

  .search-box {
    flex-direction: column;
    padding: 12px;
  }

  .search-box button {
    width: 100%;
  }
}