* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
}

body {
  min-height: 100vh;
  color: #ffffff;
  background-color: #0f172a;
  overflow-x: hidden;
}

/* Fundo com imagem da cidade */
.hero-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url("/img/background_blue.jpg");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  filter: blur(4px);
  -webkit-filter: blur(4px);
  transform: scale(1.08);
  z-index: -2;
}

.hero-overlay {
  display: none;
}

/* Layout Geral */
.app-layout {
  display: flex;
  min-height: 100vh;
  padding: 20px;
  gap: 25px;
}

/* Sidebar em Glassmorphism / Blur */
.sidebar-blur {
  width: 280px;
  height: calc(100vh - 40px);
  position: sticky;
  top: 20px;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 1px solid rgba(142, 143, 147, 0.004);
  border-radius: 20px;
  padding: 30px 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.);
  z-index: 100;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.brand {
  text-align: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  padding-bottom: 20px;
}

.brand i {
  font-size: 32px;
  color: #38bdf8;
  margin-bottom: 8px;
}

.brand h2 {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

.brand p {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.7);
}

/* Navegação */
.nav-container {
  flex: 1;
  margin-top: 25px;
  overflow-y: auto;
}

.nav-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.nav-links li a {
  display: flex;
  align-items: center;
  gap: 14px;
  color: rgba(255, 255, 255, 0.85);
  text-decoration: none;
  font-size: 14px;
  padding: 12px 16px;
  border-radius: 12px;
  transition: all 0.2s ease;
}

.nav-links li a i {
  font-size: 16px;
  width: 20px;
  text-align: center;
}

.nav-links li a:hover {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.nav-links li.active a {
  background: rgba(56, 189, 248, 0.35);
  border: 1px solid rgba(56, 189, 248, 0.5);
  color: #ffffff;
  font-weight: 600;
}

/* Perfil no rodapé da Sidebar */
.user-profile {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-top: 15px;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
}

.user-profile i {
  font-size: 28px;
  color: #38bdf8;
}

.user-info span {
  display: block;
  font-size: 13px;
  font-weight: 600;
}

.user-info small {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.6);
}

/* Conteúdo Principal */
.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 25px;
}

.welcome-card {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 20px;
  padding: 35px;
}

.welcome-card h1 {
  font-size: 28px;
  margin-bottom: 8px;
}

.welcome-card p {
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 25px;
}

.search-box {
  display: flex;
  align-items: center;
  background: rgba(15, 23, * {
